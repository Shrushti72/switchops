# SwitchOps Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── Switch Core (set these after Switch Console creates your room) ────────
# The URL where Switch Core is running (Switch Console runs it locally on port 2468)
SWITCH_CORE_URL=http://host.docker.internal:2468

# Bearer token for the alert-simulator to post messages to the room
# Get this from Switch Console → Rooms → [Your Room] → Webhook Token
SWITCH_WEBHOOK_TOKEN=sw_agent_sec_REPLACE_ME

# The room ID to post alerts into
# Get this from Switch Console → Rooms → [Your Room] → Room ID
SWITCH_ROOM_ID=REPLACE_ME

# ─── Alert Simulator ─────────────────────────────────────────────────────
# How often to poll cart-service for errors (seconds)
POLL_INTERVAL_SECONDS=10

# Error rate threshold to trigger an alert (0.05 = 5%)
ERROR_THRESHOLD=0.05
